{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lca.study-analysis-input.v2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "lca.study-analysis-input.v2"
      ]
    },
    "analysis": {
      "type": "object",
      "properties": {
        "analysisId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "studyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "profileId": {
          "type": "string",
          "enum": [
            "lca.study-sensitivity-oat.v1",
            "lca.study-uncertainty-bounded.v1"
          ]
        },
        "config": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "lca.study-analysis-config.v2",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "sensitivityOat"
                  ]
                },
                "schemaVersion": {
                  "type": "string",
                  "enum": [
                    "lca.study-analysis-config.v2"
                  ]
                },
                "baselineRunId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "maxLength": 256,
                        "pattern": "^/instances/[^/]+/exchanges/[^/]+/amount$"
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "baselineAmount": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?(e-?[1-9][0-9]*)?$"
                      },
                      "low": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?(e-?[1-9][0-9]*)?$"
                      },
                      "high": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?(e-?[1-9][0-9]*)?$"
                      }
                    },
                    "required": [
                      "path",
                      "unit",
                      "baselineAmount",
                      "low",
                      "high"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "kind",
                "schemaVersion",
                "baselineRunId",
                "parameters"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "uncertainty"
                  ]
                },
                "schemaVersion": {
                  "type": "string",
                  "enum": [
                    "lca.study-analysis-config.v2"
                  ]
                },
                "baselineRunId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "maxLength": 256,
                        "pattern": "^/instances/[^/]+/exchanges/[^/]+/amount$"
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "baselineAmount": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?(e-?[1-9][0-9]*)?$"
                      },
                      "low": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?(e-?[1-9][0-9]*)?$"
                      },
                      "high": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?(e-?[1-9][0-9]*)?$"
                      }
                    },
                    "required": [
                      "path",
                      "unit",
                      "baselineAmount",
                      "low",
                      "high"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "design": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "independentUniform"
                          ]
                        },
                        "independenceDeclared": {
                          "const": true
                        }
                      },
                      "required": [
                        "kind",
                        "independenceDeclared"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "jointEmpirical"
                          ]
                        },
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64,
                              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?(e-?[1-9][0-9]*)?$"
                            },
                            "minItems": 1
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "kind",
                        "rows"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "sampleCount": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 4294967295
                },
                "seedHex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "generator": {
                  "type": "string",
                  "enum": [
                    "study.uncertainty.hmac-drbg-sha256.v1"
                  ]
                }
              },
              "required": [
                "kind",
                "schemaVersion",
                "baselineRunId",
                "parameters",
                "design",
                "sampleCount",
                "seedHex",
                "generator"
              ],
              "additionalProperties": false
            }
          ]
        },
        "configHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "execution": {
          "type": "object",
          "properties": {
            "jobId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "status": {
              "type": "string",
              "enum": [
                "queued",
                "running"
              ]
            }
          },
          "required": [
            "jobId",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "analysisId",
        "studyId",
        "profileId",
        "config",
        "configHash",
        "execution"
      ],
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "properties": {
        "run": {
          "type": "object"
        },
        "revision": {
          "type": "object"
        },
        "scenario": {
          "type": "object"
        },
        "preparation": {
          "type": "object"
        },
        "preparedArtifact": {
          "$ref": "#/$defs/privateArtifact"
        },
        "resultArtifact": {
          "$ref": "#/$defs/privateArtifact"
        }
      },
      "required": [
        "run",
        "revision",
        "scenario",
        "preparation",
        "preparedArtifact",
        "resultArtifact"
      ],
      "additionalProperties": false
    },
    "sourceSnapshot": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "studyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "originRef": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "datasetRevision"
              ]
            },
            "datasetType": {
              "type": "string",
              "enum": [
                "lifecyclemodel"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "datasetType",
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "sourceArtifactRef": {
          "$ref": "#/$defs/artifactRef"
        },
        "digestScope": {
          "type": "string",
          "enum": [
            "artifact_bytes_sha256"
          ]
        },
        "licenseRef": {
          "type": "string",
          "minLength": 1
        },
        "issuerId": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "snapshotId",
        "studyId",
        "originRef",
        "sourceArtifactRef",
        "digestScope",
        "licenseRef",
        "issuerId",
        "observedAt"
      ],
      "additionalProperties": false
    },
    "sourceArtifact": {
      "$ref": "#/$defs/privateArtifact"
    }
  },
  "required": [
    "schemaVersion",
    "analysis",
    "baseline",
    "sourceSnapshot",
    "sourceArtifact"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifactRef": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "digestScope": {
          "type": "string",
          "enum": [
            "artifact_bytes_sha256"
          ]
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "application/json"
          ]
        },
        "schemaVersion": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "contentHash",
        "digestScope",
        "byteSize",
        "mediaType",
        "schemaVersion"
      ],
      "additionalProperties": false
    },
    "privateArtifact": {
      "type": "object",
      "properties": {
        "studyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "artifactRef": {
          "$ref": "#/$defs/artifactRef"
        },
        "storageBucket": {
          "type": "string",
          "enum": [
            "study-artifacts"
          ]
        },
        "storageObjectPath": {
          "type": "string"
        }
      },
      "required": [
        "studyId",
        "artifactRef",
        "storageBucket",
        "storageObjectPath"
      ],
      "additionalProperties": false
    }
  }
}
