{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lca.study-method-fact-catalog-entry.v1",
  "$comment": "Worker-owned closed method interface. Schema checks never establish professional approval, current actor/source/lease authority or byte identity.",
  "$ref": "#/$defs/methodReportFact",
  "$defs": {
    "datasetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "methodFactContext": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "methodRef",
            "categoryRole"
          ],
          "properties": {
            "kind": {
              "const": "characterisedCategory"
            },
            "methodRef": {
              "$ref": "#/$defs/datasetRef"
            },
            "categoryRole": {
              "enum": [
                "primary",
                "subcategory"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "methodRef"
          ],
          "properties": {
            "kind": {
              "const": "normalisedCategory"
            },
            "methodRef": {
              "$ref": "#/$defs/datasetRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "methodRef"
          ],
          "properties": {
            "kind": {
              "const": "weightedCategory"
            },
            "methodRef": {
              "$ref": "#/$defs/datasetRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "primaryMethods"
          ],
          "properties": {
            "kind": {
              "const": "candidateSingleScore"
            },
            "primaryMethods": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/datasetRef"
              },
              "minItems": 16,
              "maxItems": 16
            }
          }
        }
      ]
    },
    "methodReportFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "assessmentId",
        "baselineRunId",
        "context",
        "methodRef",
        "canonicalValue",
        "unit",
        "unitIdentity",
        "coverage",
        "reasonCodes"
      ],
      "properties": {
        "factId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "assessmentId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "baselineRunId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "context": {
          "$ref": "#/$defs/methodFactContext"
        },
        "methodRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/datasetRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "canonicalValue": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?(?:e-?[1-9][0-9]{0,2})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$",
          "allOf": [
            {
              "pattern": "[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
            }
          ]
        },
        "unitIdentity": {
          "$ref": "#/$defs/methodUnitIdentity"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$",
            "allOf": [
              {
                "pattern": "[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
              }
            ]
          },
          "minItems": 0,
          "maxItems": 32
        }
      }
    },
    "methodUnitIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "methodRef",
            "referenceQuantityId",
            "unit"
          ],
          "properties": {
            "kind": {
              "const": "characterised"
            },
            "methodRef": {
              "$ref": "#/$defs/datasetRef"
            },
            "referenceQuantityId": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$",
              "allOf": [
                {
                  "pattern": "[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "methodRef",
            "referenceQuantityId",
            "unit",
            "sourceNormalisationFactor",
            "moduleArtifactSha256"
          ],
          "properties": {
            "kind": {
              "const": "normalised"
            },
            "methodRef": {
              "$ref": "#/$defs/datasetRef"
            },
            "referenceQuantityId": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "unit": {
              "const": "1"
            },
            "sourceNormalisationFactor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$",
              "allOf": [
                {
                  "pattern": "[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
                }
              ]
            },
            "moduleArtifactSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "methodRef",
            "referenceQuantityId",
            "unit",
            "sourceNormalisationFactor",
            "sourceWeightFraction",
            "pointDefinition",
            "scalingFactor",
            "moduleArtifactSha256"
          ],
          "properties": {
            "kind": {
              "const": "weighted"
            },
            "methodRef": {
              "$ref": "#/$defs/datasetRef"
            },
            "referenceQuantityId": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "unit": {
              "const": "Pt"
            },
            "sourceNormalisationFactor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$",
              "allOf": [
                {
                  "pattern": "[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
                }
              ]
            },
            "sourceWeightFraction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$",
              "allOf": [
                {
                  "pattern": "[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
                }
              ]
            },
            "pointDefinition": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$",
              "allOf": [
                {
                  "pattern": "[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
                }
              ]
            },
            "scalingFactor": {
              "const": "1"
            },
            "moduleArtifactSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "primaryMethods",
            "unit",
            "pointDefinition",
            "scalingFactor",
            "moduleArtifactSha256"
          ],
          "properties": {
            "kind": {
              "const": "candidateScore"
            },
            "primaryMethods": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/datasetRef"
              },
              "minItems": 16,
              "maxItems": 16
            },
            "unit": {
              "const": "Pt"
            },
            "pointDefinition": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$",
              "allOf": [
                {
                  "pattern": "[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
                }
              ]
            },
            "scalingFactor": {
              "const": "1"
            },
            "moduleArtifactSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    }
  }
}
