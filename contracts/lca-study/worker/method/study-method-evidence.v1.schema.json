{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lca.study-method-evidence.v1",
  "$comment": "Worker-owned closed method interface. Schema checks never establish professional approval, current actor/source/lease authority or byte identity.",
  "$ref": "#/$defs/evidenceBody",
  "$defs": {
    "declaredCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identity",
        "version",
        "contentHash",
        "locator"
      ],
      "properties": {
        "kind": {
          "enum": [
            "normativeSource",
            "datasetRevision",
            "document",
            "professionalRecord",
            "otherDeclaredSource"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$",
          "allOf": [
            {
              "pattern": "[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
            }
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$",
          "allOf": [
            {
              "pattern": "[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
            }
          ]
        },
        "contentHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$",
          "allOf": [
            {
              "pattern": "[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
            }
          ]
        }
      }
    },
    "evidenceBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requirementId",
        "declaredKind",
        "title",
        "statement",
        "citations"
      ],
      "properties": {
        "schemaVersion": {
          "const": "lca.study-method-evidence.v1"
        },
        "requirementId": {
          "type": "string",
          "pattern": "^PEF-(?:0[1-9]|1[0-9]|20)$"
        },
        "declaredKind": {
          "enum": [
            "sourceRecord",
            "applicabilityRecord",
            "professionalRecord"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$",
          "allOf": [
            {
              "pattern": "[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
            }
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$",
          "allOf": [
            {
              "pattern": "[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
            }
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declaredCitation"
          },
          "minItems": 0,
          "maxItems": 32
        }
      }
    }
  }
}
