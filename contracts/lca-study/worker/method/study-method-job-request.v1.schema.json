{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lca.study-method-job-request.v1",
  "$comment": "Worker-owned closed method interface. Schema checks never establish professional approval, current actor/source/lease authority or byte identity.",
  "$ref": "#/$defs/jobRequest",
  "$defs": {
    "jobRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "studyId",
        "assessmentId"
      ],
      "properties": {
        "schemaVersion": {
          "const": "study.method_assessment.request.v1"
        },
        "studyId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "assessmentId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        }
      }
    }
  }
}
