{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lca.study-method-assessment-record.v1",
  "$comment": "Worker-owned closed method interface. Schema checks never establish professional approval, current actor/source/lease authority or byte identity.",
  "$ref": "#/$defs/publicAssessmentRecord",
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "contentHash",
        "digestScope",
        "byteSize",
        "mediaType",
        "schemaVersion"
      ],
      "properties": {
        "type": {
          "enum": [
            "modelInput",
            "runResult",
            "modelSource",
            "methodEvidence"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "digestScope": {
          "const": "artifact_bytes_sha256"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "mediaType": {
          "const": "application/json"
        },
        "schemaVersion": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "categoryRuleDeclaration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "noneEstablished"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "referenceId",
            "version",
            "evidenceId"
          ],
          "properties": {
            "kind": {
              "const": "commissionDeveloped"
            },
            "referenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "evidenceId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
            }
          }
        }
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "baselineRunId",
        "moduleRef",
        "declarations",
        "evidenceRefs"
      ],
      "properties": {
        "schemaVersion": {
          "const": "lca.study-method-assessment-config.v1"
        },
        "baselineRunId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
        },
        "moduleRef": {
          "$ref": "#/$defs/moduleRef"
        },
        "declarations": {
          "$ref": "#/$defs/declarations"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          },
          "maxItems": 128
        }
      }
    },
    "declarations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productRole",
        "studyPhase",
        "referenceUnitBasis",
        "categoryRule"
      ],
      "properties": {
        "productRole": {
          "$ref": "#/$defs/productRole"
        },
        "studyPhase": {
          "$ref": "#/$defs/studyPhase"
        },
        "referenceUnitBasis": {
          "$ref": "#/$defs/unitBasis"
        },
        "categoryRule": {
          "$ref": "#/$defs/categoryRuleDeclaration"
        }
      }
    },
    "declaredEvidenceKind": {
      "enum": [
        "sourceRecord",
        "applicabilityRecord",
        "professionalRecord"
      ]
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "declaredKind",
        "artifactRef"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "pattern": "^PEF-(0[1-9]|1[0-9]|20)$"
        },
        "declaredKind": {
          "$ref": "#/$defs/declaredEvidenceKind"
        },
        "artifactRef": {
          "$ref": "#/$defs/artifactRef"
        }
      }
    },
    "methodFactsRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "contentHash",
        "digestScope",
        "byteSize",
        "mediaType",
        "schemaVersion"
      ],
      "properties": {
        "type": {
          "const": "methodAssessmentFacts"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "digestScope": {
          "const": "artifact_bytes_sha256"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "mediaType": {
          "const": "application/json"
        },
        "schemaVersion": {
          "const": "lca.study-method-assessment-facts.v1"
        }
      }
    },
    "moduleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sourceCommit",
        "moduleId",
        "moduleVersion",
        "artifactSha256",
        "reviewBasisSha256",
        "sourceBindingsSha256"
      ],
      "properties": {
        "repository": {
          "const": "tiangong-lca/pcr"
        },
        "sourceCommit": {
          "const": "51c0842c67b14ba886e2edee2846e26eefac030f"
        },
        "moduleId": {
          "const": "method.pef-2021-ef31"
        },
        "moduleVersion": {
          "const": "0.1.0"
        },
        "artifactSha256": {
          "const": "b19ba5754b0bc20c44c8c65966bafafd5984cd74636f2c805c0fa4373f5554ad"
        },
        "reviewBasisSha256": {
          "const": "989391423c7f31bdf77e18ea4438fab1a27ff6708c0f44ecad8ab8813763a165"
        },
        "sourceBindingsSha256": {
          "const": "3fd9b1dc68228db3e146b6d23daac853b27b9f504f9445a0cc5a971d53257ce2"
        }
      }
    },
    "productRole": {
      "const": "finishedCementIntermediate"
    },
    "publicAssessmentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessmentId",
        "studyId",
        "profileId",
        "config",
        "configHash",
        "execution",
        "factsRef"
      ],
      "properties": {
        "assessmentId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "studyId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "profileId": {
          "const": "lca.study-method-pef-2021-ef31-cement-intermediate.v1"
        },
        "config": {
          "$ref": "#/$defs/config"
        },
        "configHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jobId",
            "status"
          ],
          "properties": {
            "jobId": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "status": {
              "enum": [
                "queued",
                "running",
                "waiting",
                "completed",
                "blocked",
                "stale",
                "failed",
                "cancelled"
              ]
            }
          }
        },
        "factsRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/methodFactsRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "studyPhase": {
      "enum": [
        "screening",
        "finalStudy"
      ]
    },
    "unitBasis": {
      "const": "declaredMass"
    }
  }
}
